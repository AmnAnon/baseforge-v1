# ============================================
# BaseForge Analytics — Environment Variables
# ============================================
# Copy this file:  cp .env.example .env.local
# Never commit .env.local
#
# Variables documented below are the ones actually read by the codebase.
# NODE_ENV is set automatically by Next.js.

# ─── Required ─────────────────────────────

# Etherscan V2 API key — fallback whale tracking when Envio is unavailable
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Database — Neon Postgres for risk history, alerts, portfolio saves
# Get one at https://console.neon.tech
DATABASE_URL=

# ─── Required — Indexer (Primary Data Source) ──

# Envio HyperSync API token — primary on-chain data indexer
# 2000x faster than RPC, real-time event streaming from Base chain.
# Get one at https://envio.dev
ENVIO_API_TOKEN=

# Sentry DSN — client-side error tracking (production)
# Get one at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# Deployment URL — used for OG image absolute URLs, Frame URL, etc.
# Set to your actual deployment host (Vercel, Railway, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Optional — Cache ──────────────────────

# Cache backend: "memory" (local dev only, per-process) or "postgres" (prod/Vercel).
# On Vercel, each serverless instance has isolated memory — CACHE_BACKEND=memory does NOT share cache.
# Production and Vercel always use postgres when DATABASE_URL is set (ignores CACHE_BACKEND=memory).
# Legacy "upstash" maps to postgres. Unset CACHE_BACKEND to auto-detect from DATABASE_URL.
# Required on Vercel: DATABASE_URL (Neon) — without it, /api/health reports cache error.
CACHE_BACKEND=postgres

# ─── Optional — Background jobs ─────────────

# Dedicated worker base URL (Fly/Railway). Health checks GET {WORKER_URL}/health.
# WORKER_URL=https://your-worker.fly.dev

# Vercel Cron secret — enables /api/cron/warm (every 2 min via vercel.json) when WORKER_URL is unset.
# Generate: openssl rand -hex 32 — also add to Vercel project env as CRON_SECRET.
CRON_SECRET=

# ─── Optional — Logging ────────────────────

# Log level in code: debug | info | warn | error (default: "info")
LOG_LEVEL=info

# ─── Optional — Sentry build-time ──────────

# Auth token used during build to upload source maps to Sentry.
# Only needed in CI; set SENTRY_ORG and SENTRY_PROJECT in your project settings.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Optional — Social / Farcaster ─────────

# Neynar API key for Farcaster social data (casts, farcasters, frame analytics)
# Get one at https://docs.neynar.com
NEYNAR_API_KEY=

# Frame URL and bot mnemonic for Farcaster Frame V2
FC_FRAME_URL=https://your-app.vercel.app
FC_BOT_MNEMONIC=

# Farcaster accountAssociation for domain verification (optional)
# Generate via Warpcast developer tools or Farcaster Hub CLI.
# Only needed for Warpcast mini app discovery — not required for Base App.
FC_ACCOUNT_HEADER=
FC_ACCOUNT_PAYLOAD=
FC_ACCOUNT_SIGNATURE=

# ─── Optional — Base Builder & OnchainKit (Phase 2) ──

# Builder code from base.dev → Settings → Builder Code (ERC-8021 attribution on txs)
NEXT_PUBLIC_BASE_BUILDER_CODE=

# Coinbase Developer Platform API key — enables in-app Swap on protocol pages
# Get one at https://portal.cdp.coinbase.com/
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# ─── Optional — Demo Mode ───────────────────

# Set to "true" to show the preview banner on the site.
# Also shown automatically on Vercel preview deployments (not production).
NEXT_PUBLIC_DEMO_MODE=false

# ─── Optional — URLs (auto-set by platform) ─

# Set automatically on Vercel — no action needed.
# For self-hosted: set to your deployment hostname.
VERCEL_URL=

# ─── Internal Defaults (do not change) ─────

# Base chain ID for Etherscan V2 and chain detection
BASE_CHAIN_ID=8453

# ─── Optional — MEV Analytics ─────────────

# Dune Analytics API key — powers the MEV monitor with labeled arbitrage/sandwich data.
# Without this key, MEV monitor falls back to heuristic classification via the indexer.
# Get one at https://dune.com/settings/api
DUNE_API_KEY=

# ─── Optional — Admin ─────────────────────

# Your Farcaster FID — gates access to /api/admin/*
ADMIN_FID=666666

# Admin API key — required to access /api/admin/* (api-keys, analytics, etc.)
# Set to a random string; pass as x-admin-key header to authenticate
ADMIN_KEY=

# Show the Admin Frame Stats bar in the UI (for demo / operators).
# Does NOT take a secret value. The bar will call the analytics endpoint without embedding secrets.
# In demo mode (NEXT_PUBLIC_DEMO_MODE=true) it shows automatically. Use this for explicit control.
NEXT_PUBLIC_SHOW_ADMIN_BAR=false

# ─── Optional — CORS ───────────────────────────────────────────────

# Restrict cross-origin access to /api/agents/* and /api/health.
# Comma-separated list of allowed origins. When unset, all origins are allowed
# (open public API — appropriate for a public agent endpoint).
# Example: CORS_ALLOWED_ORIGINS=https://your-agent.com,https://dashboard.example.com
# CORS_ALLOWED_ORIGINS=

# ─── Optional — API Key Rate Limits ────────

# Default rate limits per tier (requests per minute)
# Override per-key via /api/admin/api-keys POST body
API_RATE_LIMIT_FREE=100
API_RATE_LIMIT_PRO=1000
API_RATE_LIMIT_ENTERPRISE=10000
