{
  "name": "@baseforge/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for BaseForge's versioned API and agent context layer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
