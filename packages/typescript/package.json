    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmnAnon/baseforge-v1",
    "directory": "packages/typescript"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
